# Copy to .env.local for local dev, and set the same three in Vercel
# (Project → Settings → Environment Variables) for production.
# .env* is gitignored, so real keys never reach the repo.

# kit | buttondown | beehiiv | log
# 'log' writes to the server console instead of calling anyone. Leave it as
# 'log' and the form works end to end without capturing a real address.
SUBSCRIBE_PROVIDER=kit

# Kit: Account → Settings → Developer → API keys. Use the V4 API key.
SUBSCRIBE_API_KEY=

# Kit: the numeric id of the form the subscriber is added to. It is the last
# part of the form's URL in the Kit dashboard.
SUBSCRIBE_LIST_ID=
